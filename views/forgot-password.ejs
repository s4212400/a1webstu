<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password | ConsoleHaven</title>
    <link rel="stylesheet" href="/shared.css">
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>

    <%- include('partials/header') %>

    <main id="main-content">
        <section class="auth-section">
            <div class="auth-box">
                <h1>RESET PASSWORD</h1>

                <p class="auth-intro">Enter the email address linked to your account. We will send you a secure link to create a new password.</p>

                <% if (typeof error !== 'undefined' && error) { %>
                    <p class="error-message"><%= error %></p>
                <% } %>

                <form class="auth-form" action="/forgot-password" method="POST">

                    <div class="form-group">
                        <label for="reset-email">Email Address:</label>
                        <input type="email" id="reset-email" name="resetEmail"
                               placeholder="your@email.com" required>
                        <small class="field-hint">Must match the email registered to your account.</small>
                    </div>

                    <button type="submit" class="btn btn--primary btn--large">SEND RESET LINK</button>
                </form>

                <div class="auth-note">
                    <p><strong>Did not receive an email?</strong></p>
                    <ul>
                        <li>Check your spam or junk folder</li>
                        <li>Make sure you entered the correct address</li>
                    </ul>
                </div>

                <p class="auth-link"><a href="/login">Back to Login</a></p>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

</body>
</html>
