<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Write a Review - ConsoleHaven</title>
    <link rel="stylesheet" href="/shared.css">
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>

    <%- include('partials/header') %>

    <main id="main-content">
        <section class="page-header">
            <p class="thread-detail__breadcrumb"><a href="/reviews">← Back to Reviews</a></p>
            <h1 class="section-title">Write a Review</h1>
        </section>

        <section class="form-section">
            <div class="form-card">

                <form action="/reviews/create" method="POST" novalidate>

                    <div class="form-group">
                        <label class="form-label" for="product-select">Product</label>
                        <select id="product-select" name="product" class="select-input form-input">
                            <option value="">-- Choose a product --</option>
                            <option value="dualsense">PS5 DualSense Controller</option>
                            <option value="xbox-x">Xbox Series X 1TB</option>
                            <option value="switch-oled">Nintendo Switch OLED</option>
                            <option value="mech-keyboard">Competitive Mechanical Keyboard</option>
                        </select>
                        <span class="error-message" id="product-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Your Rating</label>
                        <div class="rating-picker-wrap">
                            <fieldset class="rating-picker">
                                <input type="radio" id="star5" name="rating" value="5">
                                <label for="star5" title="5 stars">★</label>
                                <input type="radio" id="star4" name="rating" value="4">
                                <label for="star4" title="4 stars">★</label>
                                <input type="radio" id="star3" name="rating" value="3">
                                <label for="star3" title="3 stars">★</label>
                                <input type="radio" id="star2" name="rating" value="2">
                                <label for="star2" title="2 stars">★</label>
                                <input type="radio" id="star1" name="rating" value="1">
                                <label for="star1" title="1 star">★</label>
                            </fieldset>
                            <span class="rating-picker-hint">Click a star to set your rating</span>
                        </div>
                        <span class="error-message" id="rating-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="review-title">Review Title</label>
                        <input type="text" id="review-title" name="title" class="form-input" placeholder="Summarize your experience in a few words">
                        <span class="error-message" id="title-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="review-description">Description</label>
                        <textarea id="review-description" name="description" class="form-textarea" placeholder="What did you like or dislike? How does it perform over time?"></textarea>
                        <span class="error-message" id="description-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="review-image">Product Photo (optional)</label>
                        <div class="file-drop">
                            <span>Upload a photo of the product you're reviewing</span>
                            <input type="file" id="review-image" name="image" accept="image/*">
                            <p class="form-hint">Accepted formats: JPG, PNG, GIF. Max size 5MB.</p>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Reviewer Name</label>
                        <input type="text" class="form-input" value="<%= user ? user.fullname : 'Guest' %>" disabled>
                        <p class="form-hint">Posting as your logged-in account. Date added will be recorded automatically.</p>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn--primary">Submit Review</button>
                        <a href="/reviews" class="btn btn--outline">Cancel</a>
                    </div>

                </form>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script src="/review-create.js"></script>
</body>
</html>
