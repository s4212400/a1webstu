<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | ConsoleHaven</title>
    <link rel="stylesheet" href="/shared.css">
</head>

<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>

    <%- include('partials/header') %>

    <section class="wishlist-hero">
        <h1>💳 Checkout</h1>
        <p>Enter your delivery and payment details to complete your order.</p>
    </section>

    <ol class="checkout-steps">
        <li class="step done"><span>1</span> Cart</li>
        <li class="step current" aria-current="step"><span>2</span> Checkout</li>
        <li class="step"><span>3</span> Confirmation</li>
    </ol>

    <main id="main-content" class="checkout-page">

        <form class="checkout-form" action="/cart/checkout" method="POST">

            <fieldset class="checkout-block">
                <legend>Delivery Information</legend>

                <div class="field-row">
                    <div class="form-group">
                        <label for="first-name">First Name</label>
                        <input
                            type="text"
                            id="first-name"
                            name="first-name"
                            placeholder="John"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="last-name">Last Name</label>
                        <input
                            type="text"
                            id="last-name"
                            name="last-name"
                            placeholder="Nguyen"
                            required
                        >
                    </div>
                </div>

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="john.gamer@email.com"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input
                        type="tel"
                        id="phone"
                        name="phone"
                        placeholder="0901 234 567"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="address">Street Address</label>
                    <input
                        type="text"
                        id="address"
                        name="address"
                        placeholder="702 Nguyen Van Linh"
                        required
                    >
                </div>

                <div class="field-row">
                    <div class="form-group">
                        <label for="city">City</label>
                        <input
                            type="text"
                            id="city"
                            name="city"
                            placeholder="Ho Chi Minh City"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="postcode">Postcode</label>
                        <input
                            type="text"
                            id="postcode"
                            name="postcode"
                            placeholder="700000"
                            required
                        >
                    </div>
                </div>

                <div class="form-group">
                    <label for="country">Country</label>
                    <select id="country" name="country" required>
                        <option value="vn">Vietnam</option>
                        <option value="au">Australia</option>
                        <option value="sg">Singapore</option>
                        <option value="jp">Japan</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="notes">Delivery Notes (optional)</label>
                    <textarea
                        id="notes"
                        name="notes"
                        rows="3"
                        placeholder="e.g. Leave at reception"
                    ></textarea>
                </div>

            </fieldset>

            <fieldset class="checkout-block">
                <legend>Delivery Method</legend>

                <div class="radio-row">
                    <label>
                        <input type="radio" name="delivery" value="standard" checked>
                        Standard &mdash; 5 to 7 business days (Free)
                    </label>

                    <label>
                        <input type="radio" name="delivery" value="express">
                        Express &mdash; 2 to 3 business days ($9.99)
                    </label>

                    <label>
                        <input type="radio" name="delivery" value="pickup">
                        Store Pickup &mdash; Ready in 24 hours (Free)
                    </label>
                </div>

            </fieldset>

            <fieldset class="checkout-block">
                <legend>Payment Details</legend>

                <p class="form-note">
                    🔒 This is a demonstration checkout. Do not enter real card details.
                </p>

                <div class="form-group">
                    <label for="card-name">Name on Card</label>
                    <input
                        type="text"
                        id="card-name"
                        name="card-name"
                        placeholder="JOHN NGUYEN"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="card-number">Card Number</label>
                    <input
                        type="text"
                        id="card-number"
                        name="card-number"
                        placeholder="4111 1111 1111 1111"
                        maxlength="19"
                        required
                    >
                </div>

                <div class="field-row">
                    <div class="form-group">
                        <label for="expiry">Expiry Date</label>
                        <input
                            type="text"
                            id="expiry"
                            name="expiry"
                            placeholder="MM/YY"
                            maxlength="5"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="cvv">CVV</label>
                        <input
                            type="text"
                            id="cvv"
                            name="cvv"
                            placeholder="123"
                            maxlength="4"
                            required
                        >
                    </div>
                </div>

                <div class="form-group">
                    <label for="card-type">Card Type</label>
                    <select id="card-type" name="card-type" required>
                        <option value="visa">Visa</option>
                        <option value="mastercard">Mastercard</option>
                        <option value="amex">American Express</option>
                    </select>
                </div>

                <div class="checkbox-row">
                    <label>
                        <input type="checkbox" name="same-address" checked>
                        Billing address is the same as delivery address
                    </label>

                    <label>
                        <input type="checkbox" name="terms" required>
                        I agree to the
                        <a href="/policy">Terms and Conditions</a>
                    </label>
                </div>

            </fieldset>

            <button
                type="submit"
                class="btn btn--primary btn--large checkout-submit"
            >
                Place Order
            </button>

            <a href="/cart" class="btn btn--outline checkout-back">
                ← Back to Cart
            </a>

        </form>

        <aside class="cart-summary" aria-label="Order summary">

            <h2>Your Order</h2>

            <ul class="mini-cart">
                <% cart.forEach(item => { %>
                    <li>
                        <img
                            src="<%= item.image %>"
                            alt="<%= item.name %>"
                        >

                        <span class="mini-cart__name">
                            <%= item.name %> &times;<%= item.quantity %>
                        </span>

                        <span class="mini-cart__price">
                            $<%= (item.price * item.quantity).toFixed(2) %>
                        </span>
                    </li>
                <% }) %>
            </ul>

            <div class="summary-row">
                <span>Subtotal</span>
                <span>$<%= subtotal.toFixed(2) %></span>
            </div>

            <div class="summary-row">
                <span>Discount</span>
                <span>$0.00</span>
            </div>

            <div class="summary-row">
                <span>Delivery</span>
                <span>
                    <%= shipping === 0 ? 'Free' : '$' + shipping.toFixed(2) %>
                </span>
            </div>

            <div class="summary-row">
                <span>GST (10%)</span>
                <span>$<%= tax.toFixed(2) %></span>
            </div>

            <div class="summary-row">
                <span>Total</span>
                <span>$<%= total.toFixed(2) %></span>
            </div>

        </aside>

    </main>

    <%- include('partials/footer') %>

</body>
</html>