<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - ConsoleHaven</title>
    <link rel="stylesheet" href="/shared.css">
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <%- include('partials/header') %>

    <main id="main-content">
        <section class="auth-section">
            <div class="auth-box">
                <h1>SIGN IN TO CONSOLEHAVEN</h1>
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="auth-warning-panel">
                        <p class="auth-warning-text"><%= error %></p>
                    </div>
                <% } %>

                <form class="auth-form" action="/login" method="POST" novalidate>
                    <div class="form-group">
                        <label class="form-label" for="login-email">Email or Username</label>
                        <input id="login-email" type="text" name="emailUsername" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="password">PASSWORD</label>
                        <div class="password-wrapper">
                            <input type="password" id="password" name="password" required class="password-input-field">
                            <span id="togglePassword" class="password-toggle-btn">
                                [SHOW]
                            </span>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn--primary btn--large auth-full-btn">Login</button>
                </form>

                <div class="auth-link">
                    <p>Don't have an account? <a href="/register">Register here</a></p>
                </div>
            </div>
        </section>

        <!-- JS: Show/Hide Password -->
        <script>
            const toggleBtn = document.getElementById('togglePassword');
            const passInput = document.getElementById('password');

            if (toggleBtn && passInput) {
                toggleBtn.addEventListener('click', () => {
                    if (passInput.type === 'password') {
                        passInput.type = 'text';
                        toggleBtn.textContent = '[HIDE]';
                        toggleBtn.classList.add('active-hide');
                    } else {
                        passInput.type = 'password';   
                        toggleBtn.textContent = '[SHOW]';  
                        toggleBtn.classList.remove('active-hide'); 
                    }
                });
            }
        </script>
    </main>

    <%- include('partials/footer') %>
    
</body>
</html>