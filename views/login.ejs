<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - ConsoleHaven</title>
    <link rel="stylesheet" href="/shared.css">
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <%- include('partials/header') %>

    <main id="main-content">
        <section class="auth-section">
            <div class="auth-box">
                <h1>SIGN IN TO CONSOLEHAVEN</h1>
                
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="warning-panel" style="margin-bottom: 20px; border: 2px solid #ff4444; padding: 10px; border-radius: 4px; background-color: #fff0f0;">
                        <p style="color: #ff4444; margin: 0; text-align: center; font-weight: bold;"><%= error %></p>
                    </div>
                <% } %>

                <form class="auth-form" action="/login" method="POST" novalidate>
                    <div class="form-group">
                        <label class="form-label" for="login-email">Email or Username</label>
                        <input id="login-email" type="text" name="emailUsername" required>
                    </div>
                    <div class="form-group">
                        <label for="password">PASSWORD</label>
                        <div style="position: relative; display: flex; align-items: center;">
                            <input type="password" id="password" name="password" required style="width: 100%; padding-right: 70px;">
                            <span id="togglePassword" style="position: absolute; right: 15px; cursor: pointer; color: #f39c12; font-family: monospace; font-size: 0.9rem; font-weight: bold;">
                            [SHOW]
                            </span>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn--primary btn--large auth-full-btn">Login</button>
                </form>

                <div class="auth-link">
                    <p>Don't have an account? <a href="/register">Register here</a></p>
                </div>
            </div>
        </section>

        <script>
            const toggleBtn = document.getElementById('togglePassword');
            const passInput = document.getElementById('password');

            if (toggleBtn && passInput) {
                toggleBtn.addEventListener('click', () => {
                    if (passInput.type === 'password') {
                        passInput.type = 'text';
                        toggleBtn.textContent = '[HIDE]';
                        toggleBtn.style.color = '#ff4444';
                    } else {
                        passInput.type = 'password';   
                        toggleBtn.textContent = '[SHOW]';  
                        toggleBtn.style.color = '#f39c12'; 
                    }
                });
            }
        </script>
    </main>

    <%- include('partials/footer') %>
    
</body>
</html>