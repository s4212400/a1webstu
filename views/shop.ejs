<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Shop | ConsoleHaven</title>

    <link rel="stylesheet" href="/shared.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
</head>

<body>

<a href="#main-content" class="skip-link">
    Skip to main content
</a>

<%- include('partials/header') %>

<main id="main-content">

    <div class="shop-page">

        <!-- FILTERS -->
        <aside class="shop-sidebar" aria-label="Product filters">

            <h2 class="filter-heading">
                Filter Products
            </h2>

            <form action="/shop" method="GET" class="filter-form">

                <!-- Search -->
                <div class="form-group">

                    <label for="search">
                        Search
                    </label>

                    <input
                        type="search"
                        id="search"
                        name="search"
                        placeholder="Search products..."
                        value="<%= query && query.search ? query.search : '' %>"
                    >

                </div>


                <!-- Category -->
                <h3 class="filter-heading">
                    Category
                </h3>

                <div class="form-group filter-group">

                    <label>
                        <input
                            type="checkbox"
                            name="category"
                            value="console"
                            <%= query && query.category &&
                                (Array.isArray(query.category)
                                    ? query.category.includes('console')
                                    : query.category === 'console')
                                ? 'checked'
                                : '' %>
                        >
                        Consoles
                    </label>

                    <label>
                        <input
                            type="checkbox"
                            name="category"
                            value="game"
                            <%= query && query.category &&
                                (Array.isArray(query.category)
                                    ? query.category.includes('game')
                                    : query.category === 'game')
                                ? 'checked'
                                : '' %>
                        >
                        Games
                    </label>

                    <label>
                        <input
                            type="checkbox"
                            name="category"
                            value="accessory"
                            <%= query && query.category &&
                                (Array.isArray(query.category)
                                    ? query.category.includes('accessory')
                                    : query.category === 'accessory')
                                ? 'checked'
                                : '' %>
                        >
                        Accessories
                    </label>

                </div>


                <!-- Platform -->
                <h3 class="filter-heading">
                    Platform
                </h3>

                <div class="form-group filter-group">

                    <label>
                        <input
                            type="checkbox"
                            name="platform"
                            value="ps5"
                            <%= query && query.platform &&
                                (Array.isArray(query.platform)
                                    ? query.platform.includes('ps5')
                                    : query.platform === 'ps5')
                                ? 'checked'
                                : '' %>
                        >
                        PlayStation 5
                    </label>

                    <label>
                        <input
                            type="checkbox"
                            name="platform"
                            value="xbox"
                            <%= query && query.platform &&
                                (Array.isArray(query.platform)
                                    ? query.platform.includes('xbox')
                                    : query.platform === 'xbox')
                                ? 'checked'
                                : '' %>
                        >
                        Xbox
                    </label>

                    <label>
                        <input
                            type="checkbox"
                            name="platform"
                            value="switch"
                            <%= query && query.platform &&
                                (Array.isArray(query.platform)
                                    ? query.platform.includes('switch')
                                    : query.platform === 'switch')
                                ? 'checked'
                                : '' %>
                        >
                        Nintendo Switch
                    </label>

                </div>


                <!-- Condition -->
                <h3 class="filter-heading">
                    Condition
                </h3>

                <div class="form-group">

                    <label for="condition">
                        Condition
                    </label>

                    <select
                        id="condition"
                        name="condition"
                    >

                        <option
                            value="all"
                            <%= !query || !query.condition || query.condition === 'all'
                                ? 'selected'
                                : '' %>
                        >
                            All
                        </option>

                        <option
                            value="new"
                            <%= query && query.condition === 'new'
                                ? 'selected'
                                : '' %>
                        >
                            New
                        </option>

                    </select>

                </div>


                <!-- Price -->
                <h3 class="filter-heading">
                    Price
                </h3>

                <div class="form-group">

                    <label for="min-price">
                        Minimum Price
                    </label>

                    <input
                        type="number"
                        id="min-price"
                        name="min-price"
                        min="0"
                        step="0.01"
                        placeholder="0"
                        value="<%= query && query['min-price'] ? query['min-price'] : '' %>"
                    >

                </div>

                <div class="form-group">

                    <label for="max-price">
                        Maximum Price
                    </label>

                    <input
                        type="number"
                        id="max-price"
                        name="max-price"
                        min="0"
                        step="0.01"
                        placeholder="1000"
                        value="<%= query && query['max-price'] ? query['max-price'] : '' %>"
                    >

                </div>


                <!-- Stock -->
                <h3 class="filter-heading">
                    Availability
                </h3>

                <div class="form-group filter-group">

                    <label>
                        <input
                            type="checkbox"
                            name="stock"
                            value="in"
                            <%= query && query.stock &&
                                (Array.isArray(query.stock)
                                    ? query.stock.includes('in')
                                    : query.stock === 'in')
                                ? 'checked'
                                : '' %>
                        >
                        In Stock
                    </label>

                    <label>
                        <input
                            type="checkbox"
                            name="stock"
                            value="low"
                            <%= query && query.stock &&
                                (Array.isArray(query.stock)
                                    ? query.stock.includes('low')
                                    : query.stock === 'low')
                                ? 'checked'
                                : '' %>
                        >
                        Low Stock
                    </label>

                </div>


                <button
                    type="submit"
                    class="btn btn--primary summary-btn"
                >
                    Apply Filters
                </button>

                <a
                    href="/shop"
                    class="btn btn--outline summary-btn"
                >
                    Clear Filters
                </a>

            </form>

        </aside>


        <!-- PRODUCTS -->
        <section aria-label="Products">

            <!-- Toolbar -->
            <div class="shop-toolbar">

                <div class="result-count">

                    Showing
                    <strong><%= products.length %></strong>
                    products

                </div>

                <form
                    action="/shop"
                    method="GET"
                    class="sort-form"
                >

                    <% if (query) { %>

                        <% if (query.search) { %>
                            <input
                                type="hidden"
                                name="search"
                                value="<%= query.search %>"
                            >
                        <% } %>

                        <% if (query.category) { %>

                            <% if (Array.isArray(query.category)) { %>

                                <% query.category.forEach(category => { %>

                                    <input
                                        type="hidden"
                                        name="category"
                                        value="<%= category %>"
                                    >

                                <% }) %>

                            <% } else { %>

                                <input
                                    type="hidden"
                                    name="category"
                                    value="<%= query.category %>"
                                >

                            <% } %>

                        <% } %>

                        <% if (query.platform) { %>

                            <% if (Array.isArray(query.platform)) { %>

                                <% query.platform.forEach(platform => { %>

                                    <input
                                        type="hidden"
                                        name="platform"
                                        value="<%= platform %>"
                                    >

                                <% }) %>

                            <% } else { %>

                                <input
                                    type="hidden"
                                    name="platform"
                                    value="<%= query.platform %>"
                                >

                            <% } %>

                        <% } %>

                        <% if (query.condition) { %>

                            <input
                                type="hidden"
                                name="condition"
                                value="<%= query.condition %>"
                            >

                        <% } %>

                        <% if (query['min-price']) { %>

                            <input
                                type="hidden"
                                name="min-price"
                                value="<%= query['min-price'] %>"
                            >

                        <% } %>

                        <% if (query['max-price']) { %>

                            <input
                                type="hidden"
                                name="max-price"
                                value="<%= query['max-price'] %>"
                            >

                        <% } %>

                        <% if (query.stock) { %>

                            <% if (Array.isArray(query.stock)) { %>

                                <% query.stock.forEach(stock => { %>

                                    <input
                                        type="hidden"
                                        name="stock"
                                        value="<%= stock %>"
                                    >

                                <% }) %>

                            <% } else { %>

                                <input
                                    type="hidden"
                                    name="stock"
                                    value="<%= query.stock %>"
                                >

                            <% } %>

                        <% } %>

                    <% } %>

                    <label for="sort">
                        Sort by
                    </label>

                    <select
                        id="sort"
                        name="sort"
                        onchange="this.form.submit()"
                    >

                        <option
                            value="title-asc"
                            <%= !query || !query.sort || query.sort === 'title-asc'
                                ? 'selected'
                                : '' %>
                        >
                            Title A-Z
                        </option>

                        <option
                            value="title-desc"
                            <%= query && query.sort === 'title-desc'
                                ? 'selected'
                                : '' %>
                        >
                            Title Z-A
                        </option>

                        <option
                            value="price-asc"
                            <%= query && query.sort === 'price-asc'
                                ? 'selected'
                                : '' %>
                        >
                            Price Low-High
                        </option>

                        <option
                            value="price-desc"
                            <%= query && query.sort === 'price-desc'
                                ? 'selected'
                                : '' %>
                        >
                            Price High-Low
                        </option>

                        <option
                            value="qty-desc"
                            <%= query && query.sort === 'qty-desc'
                                ? 'selected'
                                : '' %>
                        >
                            Stock High-Low
                        </option>

                        <option
                            value="qty-asc"
                            <%= query && query.sort === 'qty-asc'
                                ? 'selected'
                                : '' %>
                        >
                            Stock Low-High
                        </option>

                    </select>

                </form>

            </div>


            <!-- Product Grid -->
            <div class="shop-grid">

                <% products.forEach(product => { %>

                    <article class="shop-card">

                        <div class="shop-card__image-wrap">

                            <img
                                src="<%= product.image %>"
                                alt="<%= product.name %>"
                                class="shop-card__image"
                            >

                            <% if (product.discount) { %>

                                <span class="save-tag">
                                    -<%= product.discount %>%
                                </span>

                            <% } %>

                        </div>


                        <div class="shop-card__body">

                            <h2 class="shop-card__title">
                                <%= product.name %>
                            </h2>


                            <ul class="shop-card__specs">

                                <li>
                                    <span>Category:</span>
                                    <%= product.category %>
                                </li>

                                <li>
                                    <span>Platform:</span>
                                    <%= product.platform %>
                                </li>

                                <li>
                                    <span>Condition:</span>
                                    <%= product.condition %>
                                </li>

                            </ul>


                            <div class="rating">

                                <%= "⭐".repeat(product.rating || 0) %>

                                <span class="rating-count">
                                    (<%= product.ratingCount || 0 %>)
                                </span>

                            </div>


                            <div class="price">

                                <% if (product.oldPrice) { %>

                                    <del>
                                        $<%= Number(product.oldPrice).toFixed(2) %>
                                    </del>

                                <% } %>

                                <strong>
                                    $<%= Number(product.price).toFixed(2) %>
                                </strong>

                            </div>


                            <div class="stock">

                                <% if (product.stock > 0) { %>

                                    <% if (product.stock <= 6) { %>

                                        <span>
                                            Low Stock:
                                            <%= product.stock %>
                                        </span>

                                    <% } else { %>

                                        <span>
                                            In Stock:
                                            <%= product.stock %>
                                        </span>

                                    <% } %>

                                <% } else { %>

                                    <span>
                                        Out of Stock
                                    </span>

                                <% } %>

                            </div>


                            <% if (product.stock > 0) { %>

                                <form
                                    action="/cart/add"
                                    method="POST"
                                    class="add-form"
                                >

                                    <input
                                        type="hidden"
                                        name="productId"
                                        value="<%= product.id %>"
                                    >

                                    <label for="quantity-<%= product.id %>">
                                        Qty
                                    </label>

                                    <input
                                        type="number"
                                        id="quantity-<%= product.id %>"
                                        name="quantity"
                                        value="1"
                                        min="1"
                                        max="<%= product.stock %>"
                                    >

                                    <button
                                        type="submit"
                                        class="btn btn--primary btn--small"
                                    >
                                        Add to Cart
                                    </button>

                                </form>


                                <form
                                    action="/wishlist/add"
                                    method="POST"
                                    class="add-form"
                                >

                                    <input
                                        type="hidden"
                                        name="productId"
                                        value="<%= product.id %>"
                                    >

                                    <button
                                        type="submit"
                                        class="btn btn--outline btn--small"
                                    >
                                        Add to Wishlist
                                    </button>

                                </form>

                            <% } else { %>

                                <button
                                    type="button"
                                    class="btn btn--outline btn--small"
                                    disabled
                                >
                                    Out of Stock
                                </button>

                            <% } %>

                        </div>

                    </article>

                <% }) %>

            </div>

        </section>

    </div>

</main>

<%- include('partials/footer') %>

</body>
</html>