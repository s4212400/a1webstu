<!-- =========================
     BADGE SCRIPT
========================= -->

<script>


    const wishlistCount =
        <%= typeof wishlistCount !== 'undefined'
            ? wishlistCount
            : 0 %>;


    const cartCount =
        <%= typeof cartCount !== 'undefined'
            ? cartCount
            : 0 %>;



    const wishlistBadge =
        document.getElementById(
            'wishlist-badge'
        );


    const cartBadge =
        document.getElementById(
            'cart-badge'
        );



    if (wishlistCount > 0) {


        wishlistBadge.textContent =
            wishlistCount;


        wishlistBadge.style.display =
            'flex';


    } else {


        wishlistBadge.style.display =
            'none';


    }



    if (cartCount > 0) {


        cartBadge.textContent =
            cartCount;


        cartBadge.style.display =
            'flex';


    } else {


        cartBadge.style.display =
            'none';


    }


</script>


</body>

