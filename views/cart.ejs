<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Shopping Cart | ConsoleHaven</title>

    <link rel="stylesheet" href="/shared.css">

</head>

<body>


<a href="#main-content" class="skip-link">
    Skip to main content
</a>


 <%- include('partials/header') %>

 <!-- HERO -->

<section class="wishlist-hero">

    <h1>
        Shopping Cart
    </h1>

    <p>
        Review the products you want to purchase.
    </p>

</section>


<!-- MAIN -->

<main
    id="main-content"
    class="wishlist-page"
>


<% if (!cart || cart.length === 0) { %>


    <!-- EMPTY CART -->

    <section
        class="wishlist-container"
        aria-label="Empty cart"
    >

        <article class="wishlist-card">

            <div class="wishlist-info">

                <h2>
                    Your cart is empty
                </h2>

                <p>
                    You haven't added any products to your cart yet.
                </p>

                <a
                    href="/shop"
                    class="btn btn--primary"
                >
                    Continue Shopping
                </a>

            </div>

        </article>

    </section>


<% } else { %>


    <%
        const totalItems = cart.reduce(
            (total, item) => total + (Number(item.quantity) || 0),
            0
        );

        const subtotal = cart.reduce(
            (total, item) => {

                const currentPrice = Number(
                    item.price ?? item.newPrice ?? 0
                );

                const quantity = Number(item.quantity) || 0;

                return total + (currentPrice * quantity);
            },
            0
        );

        const savings = cart.reduce(
            (total, item) => {

                const oldPrice = Number(
                    item.oldPrice ?? item.price ?? item.newPrice ?? 0
                );

                const currentPrice = Number(
                    item.price ?? item.newPrice ?? 0
                );

                const quantity = Number(item.quantity) || 0;

                return total + (
                    Math.max(0, oldPrice - currentPrice) * quantity
                );
            },
            0
        );

        const shipping = subtotal >= 100 ? 0 : 9.99;

        const total = subtotal + shipping;
    %>


    <!-- CART ITEMS -->

    <section
        class="wishlist-container"
        aria-label="Cart items"
    >


        <% cart.forEach(item => { %>

            <%
                const currentPrice = Number(
                    item.price ?? item.newPrice ?? 0
                );

                const oldPrice = Number(
                    item.oldPrice ?? currentPrice
                );

                const quantity = Number(item.quantity) || 1;

                const itemTotal = currentPrice * quantity;
            %>


            <article class="wishlist-card">


                <!-- Product Image -->

                <a href="<%= item.productPage || '#' %>">

                    <img
                        class="wishlist-image"
                        src="<%= item.image %>"
                        alt="Cover art of <%= item.name %>"
                    >

                </a>


                <!-- Product Information -->

                <div class="wishlist-info">


                    <h2>

                        <a href="<%= item.productPage || '#' %>">
                            <%= item.name %>
                        </a>

                    </h2>


                    <p>

                        <%= item.platform || '' %>

                        <% if (item.platform && (item.genre || item.category)) { %>

                            &bull;

                        <% } %>

                        <%= item.genre || item.category || '' %>

                    </p>


                    <div class="rating">

                        <%= item.rating || '' %>

                        <% if (item.ratingCount) { %>

                            <span class="rating-count">

                                (<%= item.ratingCount %>)

                            </span>

                        <% } %>

                    </div>


                    <div class="price">

                        <% if (oldPrice > currentPrice) { %>

                            <span class="old-price">

                                $<%= oldPrice.toFixed(2) %>

                            </span>

                        <% } %>


                        <span class="new-price">

                            $<%= currentPrice.toFixed(2) %>

                        </span>

                    </div>


                    <% if (item.stock !== undefined) { %>

                        <span
                            class="stock <%= item.stockClass || (item.stock > 0 ? 'in-stock' : 'out-stock') %>"
                        >

                            <% if (typeof item.stock === 'number') { %>

                                <%= item.stock > 0 ? 'In Stock' : 'Out of Stock' %>

                            <% } else { %>

                                <%= item.stock %>

                            <% } %>

                        </span>

                    <% } %>


                    <p>

                        Quantity:

                        <strong>
                            <%= quantity %>
                        </strong>

                    </p>


                    <p>

                        Item total:

                        <strong>

                            $<%= itemTotal.toFixed(2) %>

                        </strong>

                    </p>


                </div>


                <!-- Cart Actions -->

                <div class="wishlist-actions">


                    <a
                        href="/cart/remove/<%= item.id %>"
                        class="btn btn--outline btn--danger"
                    >
                        Remove
                    </a>


                </div>


            </article>


        <% }) %>


    </section>


    <!-- CART SUMMARY -->

    <aside
        class="wishlist-summary"
        aria-label="Cart summary"
    >


        <h2>
            Cart Summary
        </h2>


        <div class="summary-row">

            <span>
                Items
            </span>

            <span>
                <%= totalItems %>
            </span>

        </div>


        <div class="summary-row">

            <span>
                Subtotal
            </span>

            <span>
                $<%= subtotal.toFixed(2) %>
            </span>

        </div>


        <div class="summary-row">

            <span>
                You save
            </span>

            <span>
                $<%= savings.toFixed(2) %>
            </span>

        </div>


        <div class="summary-row">

            <span>
                Shipping
            </span>

            <span>

                <% if (shipping === 0) { %>

                    FREE

                <% } else { %>

                    $<%= shipping.toFixed(2) %>

                <% } %>

            </span>

        </div>


        <div class="summary-row">

            <strong>
                Total
            </strong>

            <strong>
                $<%= total.toFixed(2) %>
            </strong>

        </div>


        <a href="/cart/checkout" class="btn btn--primary summary-btn">
            Proceed to Checkout
        </a>


        <a
            href="/shop"
            class="btn btn--outline summary-btn"
        >
            Continue Shopping
        </a>


    </aside>


<% } %>


</main>


 <%- include('partials/footer') %>

</body>
</html>