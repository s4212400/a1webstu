<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog - ConsoleHaven</title>
    <link rel="stylesheet" href="/shared.css">
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>
    <%- include('partials/header') %>

    <main id="main-content" class="blog-section">
        <div class="blog-header">
            <h1 class="section-title">Create New Blog Post</h1>
            <a href="/blog" class="btn btn--outline">Back to Blog</a>
        </div>

        <form class="blog-form" action="/blog-create" method="POST" novalidate>

            <div class="form-group">
                <label for="post-title">Post Title</label>
                <input type="text" id="post-title" name="title" placeholder="Enter a clear, descriptive title" maxlength="100" required>
                <small id="title-helper" class="field-hint">Maximum 100 characters.</small>
            </div>

            <div class="form-group">
                <label for="post-author">Author</label>
                <input 
                    type="text" 
                    id="post-author" 
                    name="author" 
                    value="<%= user.username %>" 
                    readonly 
                    class="input-readonly"
                    required
                >
                <small class="field-hint">Posting as <%= user.username %>.</small>
            </div>

            <div class="field-row">
                <div class="form-group">
                    <label for="post-date">Date</label>
                    <input type="date" id="post-date" name="date" required>
                </div>
                <div class="form-group">
                    <label for="post-category">Category</label>
                    <select id="post-category" name="category" required>
                        <option value="">Choose a category</option>
                        <option value="hardware">Hardware</option>
                        <option value="retro">Retro</option>
                        <option value="esports">Esports</option>
                        <option value="reviews">Reviews</option>
                    </select>
                    <small id="category-helper" class="field-hint text-error hidden">ERROR: Please select a category!</small>
                </div>
            </div>

            <div class="form-group">
                <label for="post-tags">Tags</label>
                <input type="text" id="post-tags" name="tags" placeholder="nintendo, handheld, review">
            </div>

            <div class="form-group">
                <label for="post-image">Cover Image URL</label>
                <input type="url" id="post-image" name="image" placeholder="https://images.unsplash.com/...">
                <small class="field-hint">Shown as the thumbnail on the blog list page.</small>
            </div>

            <div class="form-group">
                <label for="post-content">Post Content</label>
                <textarea id="post-content" name="content" rows="14" placeholder="Write your post here" required></textarea>
                <small id="content-helper" class="field-hint text-error hidden">ERROR: Content cannot be empty!</small>
            </div>

            <div class="blog-form__actions">
                <button type="submit" class="btn btn--primary btn--large">Publish Post</button>
                <a href="/blog" class="btn btn--outline">Cancel</a>
            </div>

        </form>
    </main>

    <!-- JS: Live Validation, Submit Validation and Web Storage -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const blogForm = document.querySelector('.blog-form');
            
            const titleInput = document.getElementById('post-title');
            const titleHelper = document.getElementById('title-helper');
            
            const dateInput = document.getElementById('post-date');
            
            const categoryInput = document.getElementById('post-category');
            const categoryHelper = document.getElementById('category-helper');
            
            const tagsInput = document.getElementById('post-tags');
            const imageInput = document.getElementById('post-image');
            
            const contentInput = document.getElementById('post-content');
            const contentHelper = document.getElementById('content-helper');

            // 1. WEB STORAGE
            if (titleInput && localStorage.getItem('blog_title')) {
                titleInput.value = localStorage.getItem('blog_title');
                titleInput.dispatchEvent(new Event('input')); 
            }
            if (categoryInput && localStorage.getItem('blog_category')) {
                categoryInput.value = localStorage.getItem('blog_category');
                categoryInput.dispatchEvent(new Event('change'));
            }
            if (tagsInput && localStorage.getItem('blog_tags')) {
                tagsInput.value = localStorage.getItem('blog_tags');
            }
            if (imageInput && localStorage.getItem('blog_image')) {
                imageInput.value = localStorage.getItem('blog_image');
            }
            if (contentInput && localStorage.getItem('blog_content')) {
                contentInput.value = localStorage.getItem('blog_content');
                contentInput.dispatchEvent(new Event('input'));
            }

            if (dateInput) {
                if (localStorage.getItem('blog_date')) {
                    dateInput.value = localStorage.getItem('blog_date');
                } else {
                    const now = new Date();
                    dateInput.value = now.toISOString().split('T')[0];
                }
            }

            // 2. LIVE VALIDATION and SAVING STORAGE

            if (titleInput) {
                titleInput.addEventListener('input', function() {
                    localStorage.setItem('blog_title', titleInput.value);

                    if (titleInput.value.trim().length === 0) {
                        if (titleInput.value.length > 0) {
                            titleHelper.textContent = 'ERROR: Title cannot be just spaces!';
                            titleHelper.classList.add('text-error');
                            titleHelper.classList.remove('text-success');
                        } else {
                            titleHelper.textContent = 'Maximum 100 characters.';
                            titleHelper.classList.remove('text-success', 'text-error');
                        }
                    } else {
                        titleHelper.textContent = 'Title looks good!';
                        titleHelper.classList.add('text-success');
                        titleHelper.classList.remove('text-error');
                    }
                });
            }

            // Date, Tags, Image 
            if (dateInput) {
                dateInput.addEventListener('change', () => localStorage.setItem('blog_date', dateInput.value));
            }
            if (tagsInput) {
                tagsInput.addEventListener('input', () => localStorage.setItem('blog_tags', tagsInput.value));
            }
            if (imageInput) {
                imageInput.addEventListener('input', () => localStorage.setItem('blog_image', imageInput.value));
            }

            if (categoryInput) {
                categoryInput.addEventListener('change', function() {
                    localStorage.setItem('blog_category', categoryInput.value);
                    if (categoryInput.value === '') {
                        categoryHelper.classList.remove('hidden');
                    } else {
                        categoryHelper.classList.add('hidden');
                    }
                });
            }

            if (contentInput) {
                contentInput.addEventListener('input', function() {
                    localStorage.setItem('blog_content', contentInput.value);
                    if (contentInput.value.trim().length > 0) {
                        contentHelper.classList.add('hidden');
                        contentInput.classList.remove('text-error');
                    }
                });
            }

            // 3. SUBMIT VALIDATION
            if (blogForm) {
                blogForm.addEventListener('submit', function(event) {
                    let isValid = true;
                    let firstInvalidInput = null;

                    if (titleInput.value.trim().length === 0) {
                        isValid = false;
                        titleHelper.textContent = 'ERROR: Post Title is required!';
                        titleHelper.classList.add('text-error');
                        titleHelper.classList.remove('text-success');
                        if (!firstInvalidInput) firstInvalidInput = titleInput;
                    }

                    if (categoryInput.value === '') {
                        isValid = false;
                        categoryHelper.classList.remove('hidden');
                        if (!firstInvalidInput) firstInvalidInput = categoryInput;
                    }

                    if (contentInput.value.trim().length === 0) {
                        isValid = false;
                        contentHelper.classList.remove('hidden');
                        if (!firstInvalidInput) firstInvalidInput = contentInput;
                    }

                    if (!isValid) {
                        event.preventDefault();
                        if (firstInvalidInput) {
                            firstInvalidInput.focus(); 
                        }
                    } else {
                        localStorage.removeItem('blog_title');
                        localStorage.removeItem('blog_date');
                        localStorage.removeItem('blog_category');
                        localStorage.removeItem('blog_tags');
                        localStorage.removeItem('blog_image');
                        localStorage.removeItem('blog_content');
                    }
                });
            }
        });
    </script>

    <%- include('partials/footer') %>

</body>
</html>