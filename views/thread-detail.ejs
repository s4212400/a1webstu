<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= thread.title %> | ConsoleHaven</title>
    <link rel="stylesheet" href="/shared.css">
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>

    <%- include('partials/header') %>

    <main id="main-content">
        <section class="thread-detail">

            <div class="thread-detail__header">
                <p class="thread-detail__breadcrumb"><a href="/forum">← Back to Forum</a></p>
                <h1 class="thread-detail__title"><%= thread.title %></h1>
                <p class="thread-detail__breadcrumb">
                    <%= replies.length %> replies &nbsp;•&nbsp;
                    Started <%= new Date(thread.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %>
                </p>
            </div>

            <!-- Original post -->
            <article class="post-block post-block--op">
                <div class="post-block__side">
                    <div class="post-block__avatar">🕹️</div>
                    <div class="post-block__author"><%= thread.author ? thread.author.fullname : "Unknown" %></div>
                    <div class="post-block__role">Original Poster</div>
                </div>
                <div class="post-block__main">
                    <div class="post-block__meta">
                        <span>Posted: <%= new Date(thread.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %></span>
                        <span>Post #1</span>
                    </div>
                    <% if (thread.imageUrl) { %>
                        <div class="post-block__image">
                            <img src="<%= thread.imageUrl %>" alt="" style="max-width:100%; border-radius:8px; margin-bottom:0.75rem;">
                        </div>
                    <% } %>
                    <div class="post-block__content">
                        <p><%= thread.content %></p>
                    </div>
                    <% if (user && thread.author && thread.author._id.toString() === user._id.toString()) { %>
                        <div class="post-block__actions">
                            <a href="/forum/edit/<%= thread._id %>" class="btn btn--outline btn--small">Edit</a>
                            <form action="/forum/delete/<%= thread._id %>" method="POST" style="display:inline;"
                                onsubmit="return confirm('Are you sure you want to delete this thread?');">
                                <button type="submit" class="btn btn--danger btn--small">Delete</button>
                            </form>
                        </div>
                    <% } %>
                </div>
            </article>

            <h2 class="replies-title">Replies (<%= replies.length %>)</h2>

            <!-- Replies generated from data -->
            <% replies.forEach((reply, index) => { %>
                <article class="post-block">
                    <div class="post-block__side">
                        <div class="post-block__avatar">👾</div>
                        <div class="post-block__author"><%= reply.author ? reply.author.fullname : "Unknown" %></div>
                        <div class="post-block__role">Member</div>
                    </div>
                    <div class="post-block__main">
                        <div class="post-block__meta">
                            <span>Posted: <%= new Date(reply.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %></span>
                            <span>Post #<%= index + 2 %></span>
                        </div>
                        <div class="post-block__content">
                            <% if (reply.deleted) { %>
                                <p>[This post has been removed by the author]</p>
                            <% } else { %>
                                <% if (reply.imageUrl) { %>
                                    <img src="<%= reply.imageUrl %>" alt="" style="max-width:100%; border-radius:8px; margin-bottom:0.75rem;">
                                <% } %>
                                <p><%= reply.content %></p>
                            <% } %>
                        </div>
                        <% if (!reply.deleted && user && reply.author && reply.author._id.toString() === user._id.toString()) { %>
                            <div class="post-block__actions">
                                <form action="/forum/<%= thread._id %>/reply/<%= reply._id %>/delete" method="POST" style="display:inline;"
                                    onsubmit="return confirm('Remove this reply?');">
                                    <button type="submit" class="btn btn--danger btn--small">Delete</button>
                                </form>
                            </div>
                        <% } %>
                    </div>
                </article>
            <% }) %>

            <!-- Reply form -->
            <% if (user) { %>
                <form class="comment-form" action="/forum/<%= thread._id %>/reply" method="POST">
                    <label class="form-label" for="reply-box">Post a Reply</label>
                    <textarea id="reply-box" name="content" rows="4" placeholder="Share your strategy or answer..." required></textarea>
                    <label class="form-label" for="reply-image">Image URL (optional)</label>
                    <input type="text" id="reply-image" name="imageUrl" class="form-input" placeholder="https://example.com/image.jpg">
                    <button type="submit" class="btn btn--primary">Post Reply</button>
                </form>
            <% } else { %>
                <p><a href="/login">Log in</a> to reply to this thread.</p>
            <% } %>

        </section>
    </main>

    <%- include('partials/footer') %>

</body>
</html>
