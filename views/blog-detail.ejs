<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.title %> - ConsoleHaven</title>
    <link rel="stylesheet" href="/shared.css">
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>
    <%- include('partials/header') %>

    <main id="main-content">
        <section class="blog-detail-section">
            
            <a href="/blog" class="btn btn--outline btn-back-databanks">&larr; BACK TO DATABANKS</a>
            
            <h1 class="section-title blog-detail-title"><%= post.title %></h1>
            <div class="blog-meta blog-meta-box">
                <span>AUTHOR: <%= post.author || 'UNKNOWN' %></span> | 
                <span>DATE: [ <%= post.date %> ]</span> | 
                <span>CATEGORY: <%= post.category || 'GENERAL' %></span>
            </div>

            <% if (user && (user.username === post.author || user.username === 'admin123')) { %>
                <div class="blog-actions">
                    <a href="/blog/<%= post.id %>/edit" class="btn btn--outline btn-edit-record">EDIT RECORD</a>
                    
                    <form action="/blog/<%= post.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('WARNING: DATABANK RECORD WILL BE PURGED. ARE YOU SURE?');">
                        <button type="submit" class="btn btn--primary btn-delete-record">DELETE RECORD</button>
                    </form>
                </div>
            <% } %>

            <div class="blog-image-container">
                <img src="<%= post.imageUrl %>" alt="<%= post.title %>" class="blog-detail-img">
            </div>
            
            <div class="blog-content blog-content-body">
                <%- post.content %> 
            </div>
            
        </section>
    </main>

    <%- include('partials/footer') %>

</body>
</html>