<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Record - ConsoleHaven</title>
    <link rel="stylesheet" href="/shared.css">
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>
    <%- include('partials/header') %>

    <main id="main-content">
        <section class="auth-section blog-edit-section">
            <div class="auth-box auth-box-full">
                <h1 class="blog-edit-title">[ SYSTEM UPDATE: EDIT RECORD ]</h1>
                
                <form class="auth-form" id="edit-form" action="/blog/<%= post.id %>/edit" method="POST" novalidate>
                    
                    <div class="form-group">
                        <label class="form-label" for="edit-title">Title</label>
                        <input id="edit-title" type="text" name="title" value="<%= post.title %>" required>
                        <small id="edit-title-helper" class="form-helper-text text-error hidden" style="margin-top: 5px; display: block;">ERROR: Title cannot be empty!</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="edit-author">Author</label>
                        <input id="edit-author" type="text" name="author" value="<%= post.author %>" readonly class="input-readonly" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="edit-category">Category (Hardware / Retro / Esports / Reviews)</label>
                        <select id="edit-category" name="category" class="retro-select" required>
                            <option value="">Choose a category</option>
                            <option value="Hardware" <%= post.category && post.category.toLowerCase() === 'hardware' ? 'selected' : '' %>>Hardware</option>
                            <option value="Retro" <%= post.category && post.category.toLowerCase() === 'retro' ? 'selected' : '' %>>Retro</option>
                            <option value="Esports" <%= post.category && post.category.toLowerCase() === 'esports' ? 'selected' : '' %>>Esports</option>
                            <option value="Reviews" <%= post.category && post.category.toLowerCase() === 'reviews' ? 'selected' : '' %>>Reviews</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="edit-tags">Tags</label>
                        <input id="edit-tags" type="text" name="tags" value="<%= post.tags || '' %>" placeholder="e.g., nintendo, review">
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="edit-image">Image URL</label>
                        <input id="edit-image" type="text" name="image" value="<%= post.imageUrl %>">
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="edit-content">Content</label>
                        <textarea id="edit-content" name="content" rows="10" required class="retro-textarea"><%= post.content %></textarea>
                        <small id="edit-content-helper" class="form-helper-text text-error hidden" style="margin-top: 5px; display: block;">ERROR: Content cannot be empty!</small>
                    </div>
                    
                    <button type="submit" class="btn btn--primary btn--large auth-full-btn btn--override">SAVE OVERRIDE</button>
                    <a href="/blog/<%= post.id %>" class="btn btn--outline btn--large auth-full-btn btn--spacing-center">CANCEL UPDATE</a>
                </form>
            </div>
        </section>
    </main>

    <!-- JS: Live Validation and Submit Validation -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const editForm = document.getElementById('edit-form');
            
            const titleInput = document.getElementById('edit-title');
            const titleHelper = document.getElementById('edit-title-helper');
            
            const contentInput = document.getElementById('edit-content');
            const contentHelper = document.getElementById('edit-content-helper');

            // 1. Live Validation
            if (titleInput) {
                titleInput.addEventListener('input', () => {
                    if (titleInput.value.trim().length === 0) {
                        titleHelper.classList.remove('hidden');
                    } else {
                        titleHelper.classList.add('hidden');
                    }
                });
            }

            if (contentInput) {
                contentInput.addEventListener('input', () => {
                    if (contentInput.value.trim().length === 0) {
                        contentHelper.classList.remove('hidden');
                    } else {
                        contentHelper.classList.add('hidden');
                    }
                });
            }

            // 2. Submit Validation
            if (editForm) {
                editForm.addEventListener('submit', (event) => {
                    let isValid = true;
                    let firstInvalidInput = null;

                    if (titleInput.value.trim().length === 0) {
                        isValid = false;
                        titleHelper.classList.remove('hidden');
                        if (!firstInvalidInput) firstInvalidInput = titleInput;
                    }

                    if (contentInput.value.trim().length === 0) {
                        isValid = false;
                        contentHelper.classList.remove('hidden');
                        if (!firstInvalidInput) firstInvalidInput = contentInput;
                    }

                    if (!isValid) {
                        event.preventDefault();
                        if (firstInvalidInput) {
                            firstInvalidInput.focus();
                        }
                    }
                });
            }
        });
    </script>

    <%- include('partials/footer') %>
</body>
</html>