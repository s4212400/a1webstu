<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Record - ConsoleHaven</title>
    <link rel="stylesheet" href="/shared.css">
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>
    <%- include('partials/header') %>

    <main id="main-content">
        <section class="auth-section blog-edit-section">
            <div class="auth-box auth-box-full">
                <h1 class="blog-edit-title">[ SYSTEM UPDATE: EDIT RECORD ]</h1>
                
                <form class="auth-form" action="/blog/<%= post.id %>/edit" method="POST">
                    
                    <div class="form-group">
                        <label class="form-label" for="edit-title">Title</label>
                        <input id="edit-title" type="text" name="title" value="<%= post.title %>" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="edit-author">Author</label>
                        <input id="edit-author" type="text" name="author" value="<%= post.author %>" readonly class="input-readonly" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="edit-category">Category (Hardware / Retro / Esports / Reviews)</label>
                        <select id="edit-category" name="category" class="retro-select" required>
                            <option value="">Choose a category</option>
                            <option value="Hardware" <%= post.category && post.category.toLowerCase() === 'hardware' ? 'selected' : '' %>>Hardware</option>
                            <option value="Retro" <%= post.category && post.category.toLowerCase() === 'retro' ? 'selected' : '' %>>Retro</option>
                            <option value="Esports" <%= post.category && post.category.toLowerCase() === 'esports' ? 'selected' : '' %>>Esports</option>
                            <option value="Reviews" <%= post.category && post.category.toLowerCase() === 'reviews' ? 'selected' : '' %>>Reviews</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="edit-image">Image URL</label>
                        <input id="edit-image" type="text" name="image" value="<%= post.imageUrl %>">
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="edit-content">Content</label>
                        <textarea id="edit-content" name="content" rows="10" required class="retro-textarea"><%= post.content %></textarea>
                    </div>
                    
                    <button type="submit" class="btn btn--primary btn--large auth-full-btn btn--override">SAVE OVERRIDE</button>
                    <a href="/blog/<%= post.id %>" class="btn btn--outline btn--large auth-full-btn btn--spacing-center">CANCEL UPDATE</a>
                </form>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>