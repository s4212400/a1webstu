<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ConsoleHaven - Premium Gaming Gear</title>
    <link rel="stylesheet" href="/shared.css">
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>

    <%- include('partials/header') %>

    <main id="main-content">
        <!-- Hero Section -->
        <section class="hero">
            <div class="hero__content">
                <% if (user) { %>
                    <h1 id="hero-title" class="hero-title--user">WELCOME BACK, <%= user.username.toUpperCase() %>!</h1>
                <% } else { %>
                    <h1 id="hero-title">LEVEL UP YOUR SETUP</h1>
                <% } %>
                
                <p>Discover the latest consoles, elite controllers and ultimate gaming gear.</p>
                <a href="/shop" class="btn btn--primary btn--large">Shop Now</a>
            </div>
        </section>

        <!-- Product Grid Layout -->
        <section class="featured">
            <h2 class="section-title">Trending Gear</h2>
            <div class="product-grid">
                
                <!-- Product Card 1 -->
                <article class="card">
                    <div class="card__image-container">
                        <img src="/images/ps_controller.jpg" alt="PS5 DualSense Controller" class="card__image">
                        <button class="btn--wishlist" title="Add to Wishlist">🤍</button>
                    </div>
                    <div class="card__content">
                        <h3 class="card__title"><a href="/product-dualsense">PS5 DualSense Controller</a></h3>
                        <div class="card__meta">
                            <span>Haptic Feedback</span>
                            <span>Wireless</span>
                        </div>
                        <div class="card__rating">⭐⭐⭐⭐⭐ (3.2k)</div>
                        <div class="card__footer">
                            <span class="card__price">$69.99</span>
                            <button class="btn btn--primary">Add to Cart</button>
                        </div>
                    </div>
                </article>

                <!-- Product Card 2 -->
                <article class="card">
                    <div class="card__image-container">
                        <img src="/images/xbox.jpg" alt="Xbox Series X Console" class="card__image">
                        <button class="btn--wishlist" title="Add to Wishlist">🤍</button>
                    </div>
                    <div class="card__content">
                        <h3 class="card__title"><a href="/product-xbox">Xbox Series X 1TB</a></h3>
                        <div class="card__meta">
                            <span>4K Gaming</span>
                            <span>120 FPS</span>
                        </div>
                        <div class="card__rating">⭐⭐⭐⭐⭐ (5.1k)</div>
                        <div class="card__footer">
                            <span class="card__price">$499.99</span>
                            <button class="btn btn--primary">Add to Cart</button>
                        </div>
                    </div>
                </article>

                <!-- Product Card 3 -->
                <article class="card">
                    <div class="card__image-container">
                        <img src="/images/nintendo_oled.jpg" alt="Nintendo Switch OLED" class="card__image">
                        <button class="btn--wishlist" title="Add to Wishlist">🤍</button>
                    </div>
                    <div class="card__content">
                        <h3 class="card__title"><a href="/product-switch-oled">Nintendo Switch OLED</a></h3>
                        <div class="card__meta">
                            <span>7-inch Screen</span>
                            <span>Handheld</span>
                        </div>
                        <div class="card__rating">⭐⭐⭐⭐ (2.8k)</div>
                        <div class="card__footer">
                            <span class="card__price">$349.99</span>
                            <button class="btn btn--primary">Add to Cart</button>
                        </div>
                    </div>
                </article>

            </div>
        </section>
        
        <!-- Tech News -->
        <section class="featured section-spacing">
            <h2 class="section-title">Latest Tech News</h2>
            <div class="product-grid" id="dynamic-blog-container">
                
                <% if (typeof blogs !== 'undefined' && blogs.length > 0) { %>
                    <% blogs.slice(0, 3).forEach(post => { %>
                        <article class="card">
                            <div class="card__image-container">
                                <img src="<%= post.imageUrl %>" alt="<%= post.title %>" class="card__image blog-card-img">
                            </div>
                            <div class="card__content">
                                <h3 class="card__title"><a href="/blog/<%= post.id %>"><%= post.title %></a></h3>
                                <div class="card__meta blog-card-meta">
                                    <span>[ <%= post.category %> ]</span>
                                    <span><%= post.date %></span>
                                </div>
                                <div class="card__footer blog-card-footer">
                                    <a href="/blog/<%= post.id %>" class="btn btn--outline btn--block">READ MORE</a>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                <% } else { %>
                    <p class="empty-blog-message">
                        > Scanning databanks for latest news...
                    </p>
                <% } %>

            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script src="/group.js"></script>
    <script src="/index.js"></script>

</body>
</html>