<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forum | ConsoleHaven</title>
    <link rel="stylesheet" href="/shared.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>

    <%- include('partials/header') %>

    <main id="main-content">
        <section class="page-header">
            <div class="page-header__top">
                <div>
                    <h1 class="section-title">Discussion Forum</h1>
                    <p class="page-subtitle">Ask about the rules, debate strategy or share your best plays with the community.</p>
                </div>
                <a href="/forum/create" class="btn btn--create">+ Start New Thread</a>
            </div>
        </section>

        <!-- Filter toolbar - submits as a real GET request, filtered/sorted server-side in MongoDB -->
        <section class="filter-toolbar">
            <form class="filter-toolbar__row" method="GET" action="/forum" style="display:flex; gap:1rem; align-items:flex-end; flex-wrap:wrap; width:100%;">
                <div class="search-bar u-grow">
                    <input type="text" name="search" value="<%= currentSearch %>" placeholder="FILTER BY TITLE OR POST CONTENT..." class="search-input">
                </div>

                <div class="select-group">
                    <label for="sort-by">Sort by:</label>
                    <select id="sort-by" name="sort" class="select-input">
                        <option value="title-asc" <%= currentSort === 'title-asc' ? 'selected' : '' %>>Thread Title (A-Z)</option>
                        <option value="title-desc" <%= currentSort === 'title-desc' ? 'selected' : '' %>>Thread Title (Z-A)</option>
                        <option value="newest-reply" <%= currentSort === 'newest-reply' ? 'selected' : '' %>>Most Recent Post</option>
                        <option value="oldest-reply" <%= currentSort === 'oldest-reply' ? 'selected' : '' %>>Oldest Post</option>
                    </select>
                </div>

                <button type="submit" class="btn btn--outline">Apply</button>
            </form>
        </section>

        <!-- Thread list generated from server data -->
        <section class="forum-section">
            <div class="thread-list">

                <% threads.forEach(thread => { %>
                    <article class="thread-card">
                        <div class="thread-card__icon">💬</div>
                        <div class="thread-card__body">
                            <h2 class="thread-card__title">
                                <a href="/forum/<%= thread._id %>"><%= thread.title %></a>
                            </h2>
                            <p class="thread-card__snippet"><%= thread.content %></p>
                            <div class="thread-card__meta">
                                <span>👤 <%= thread.author ? thread.author.fullname : "Unknown" %></span>
                                <span class="thread-date">🗓️ <%= new Date(thread.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %></span>
                            </div>
                        </div>

                        <div class="thread-card__stats">
                            <strong><%= thread.replyCount %></strong>
                            <span>REPLIES</span>
                        </div>
                    </article>
                <% }) %>

                <% if (threads.length === 0) { %>
                    <p>No threads match your search.</p>
                <% } %>

            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

</body>
</html>
