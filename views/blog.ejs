<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog - ConsoleHaven</title>
    <link rel="stylesheet" href="/shared.css">
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>
    <%- include('partials/header') %>

<!--  Main Blog  -->
<main id="main-content">
    <section class="blog-section">
        <div class="blog-header">
            <h2 class="section-title">LATEST TECH NEWS & REVIEWS</h2>
            <a href="/blog-create" class="btn btn--outline btn--create">+ CREATE NEW POST</a>
        </div>
    
        <!-- Blog Controls -->
        <div class="blog-controls">
            <form class="search-bar" action="/blog" method="GET">
                <input type="text" name="search" placeholder="SEARCH DATABANKS..." class="search-input">
                <button type="submit" class="btn btn--primary">SEARCH</button> 
            </form>
            
            <div class="blog-categories">
                <button type="button" class="category-btn active">ALL</button>
                <button type="button" class="category-btn">HARDWARE</button>
                <button type="button" class="category-btn">RETRO</button>
                <button type="button" class="category-btn">ESPORTS</button>
            </div>
        </div>
        
        <div class="blog-grid">
            <% if (typeof blogs !== 'undefined' && blogs.length > 0) { %>
                <% blogs.forEach(function(post) { %>
                    <article class="blog-card">
                        <div class="blog-card__image">
                            <img src="<%= post.imageUrl ? post.imageUrl : 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=600&q=80' %>" alt="<%= post.title %>">
                        </div>
                        <div class="blog-card__content">
                            <span class="blog-card__date">[ <%= post.date %> ]</span>
                            <h3 class="blog-card__title"><a href="/blog/<%= post.id %>"><%= post.title %></a></h3>     

                            <p class="blog-card__excerpt"><%= post.content ? post.content.substring(0, 120) : '' %>...</p> 
                            <a href="/blog/<%= post.id %>" class="btn btn--outline">READ MORE</a>
                        </div>
                    </article>
                <% }); %>
            <% } else { %>
                <div style="grid-column: 1 / -1; text-align: center; padding: 50px 0;">
                    <p style="color: #888; font-size: 1.2rem; margin-bottom: 20px;">DATABANKS EMPTY. NO RECORDS FOUND.</p>
                    <a href="/blog-create" class="btn btn--primary">BE THE FIRST TO WRITE</a>
                </div>
            <% } %>
        </div>
    </section>
</main>

<%- include('partials/footer') %>

</body>
</html>