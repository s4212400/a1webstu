<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - ConsoleHaven</title>
    <link rel="stylesheet" href="/shared.css">
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <%- include('partials/header') %>

    <main id="main-content">
        <section class="auth-section">
            <div class="auth-box auth-box--wide">
                <h1>CREATE NEW ACCOUNT</h1>

                <!-- Display error from Server -->
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="auth-warning-panel">
                        <p class="auth-warning-text"><%= error %></p>
                    </div>
                <% } %>

                <form class="auth-form" action="/register" method="POST" novalidate>
                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text" name="fullname" required>
                        <small class="form-helper-text">Enter your real name or gaming alias.</small>
                    </div>
                    
                    <div class="form-group">
                        <label>Username</label>
                        <input type="text" name="username" required>
                        <small class="form-helper-text">Must be unique. No spaces allowed.</small>
                    </div>
                    
                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" name="email" required>
                        <small class="form-helper-text">Enter a valid email address. It will be kept private.</small>
                    </div>
                    
                    <div class="form-group">
                        <label>Short Description (Bio)</label>
                        <textarea name="description" rows="3"></textarea>
                        <small class="form-helper-text">Tell us about your favorite games or consoles.</small>
                    </div>
                    
                    <div class="form-group">
                        <label for="password">PASSWORD</label>

                        <div class="password-wrapper">
                            <input type="password" id="password" name="password" required class="password-input-field">
                            <span id="togglePassword" class="password-toggle-btn">[SHOW]</span>
                        </div>

                        <small id="password-helper" class="form-helper-text">
                            Min 8 chars. Must include 4 numbers & 1 special char (!@#$%).
                        </small>
                    </div>

                    <button type="submit" class="btn btn--primary">REGISTER ACCOUNT</button>
                </form>
                
                <div class="auth-link">
                    <p>Already have an account? <a href="/login">Sign in here</a></p>
                </div>
            </div>
        </section>

        <!-- JS: Show/Hide Password -->
        <script>
            const toggleBtn = document.getElementById('togglePassword');
            const passInput = document.getElementById('password');

            if (toggleBtn && passInput) {
                toggleBtn.addEventListener('click', () => {
                    if (passInput.type === 'password') {
                        passInput.type = 'text';
                        toggleBtn.textContent = '[HIDE]';
                        toggleBtn.classList.add('active-hide'); 
                    } else {
                        passInput.type = 'password';   
                        toggleBtn.textContent = '[SHOW]';  
                        toggleBtn.classList.remove('active-hide'); 
                    }
                });
            }
        </script>

        <!-- JS: Validate Client Side -->
        <script>
            const registerForm = document.querySelector('.auth-form');
            const passwordInput = document.getElementById('password');
            const passwordHelper = document.getElementById('password-helper');

            if (registerForm) {
                registerForm.addEventListener('submit', function(event) {
                    const pwd = passwordInput.value;

                    const isLengthValid = pwd.length >= 8;
                    const numCount = (pwd.match(/\d/g) || []).length;
                    const isNumberValid = numCount >= 4;
                    const isSpecialValid = /[!@#$%^&*(),.?":{}|<>]/.test(pwd);

                    if (!isLengthValid || !isNumberValid || !isSpecialValid) {
                        event.preventDefault(); 
                        passwordHelper.classList.add('error');
                        passwordHelper.textContent = 'INVALID PASSWORD! Need: Min 8 chars, 4 numbers, 1 special char (!@#$%).';
                        passwordInput.focus();
                    }
                });
            }
        </script>
    </main>

    <%- include('partials/footer') %>
</body>
</html>