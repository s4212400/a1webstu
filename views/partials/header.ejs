    <!-- Header -->
    <header class="header">
        <div class="header__container">
            <a href="/" class="logo">🎮 ConsoleHaven</a>
            <nav class="nav">
                <ul class="nav__list">
                    <li class="nav__item"><a href="/" class="nav__link">Home</a></li>
                    <li class="nav__item"><a href="/shop" class="nav__link">Shop</a></li>
                    <li class="nav__item"><a href="/forum" class="nav__link">Forum</a></li>
                    <li class="nav__item"><a href="/reviews" class="nav__link">Reviews</a></li>
                    <li class="nav__item"><a href="/blog" class="nav__link">Blog</a></li>
                    <li class="nav__item"><a href="/wishlist" class="nav__link">Wishlist</a></li>
                </ul>
            </nav>
            <div class="header__actions">
                <a href="/cart" class="btn btn--icon" title="Cart">🛒</a>
                <% if (user) { %>
                    <a href="/profile" class="btn btn--icon" title="My profile">&#128100;</a>
                    <span style="color: #fff; font-size: 1.15rem; margin: 0 15px 0 10px; white-space: nowrap; display: inline-flex; align-items: center;">
                        Welcome, <%= user.username %>
                    </span>
                    <a href="/logout" class="btn btn--outline">Logout</a>
                <% } else { %>
                    <a href="/login" class="btn btn--outline">Login</a>
                    <a href="/register" class="btn btn--primary">Register</a>
                <% } %>
            </div>
        </div>
    </header>

<!-- MENU ACTIVE -->
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const currentPath = window.location.pathname; 
        
        const navLinks = document.querySelectorAll('.nav__link'); 
        
        navLinks.forEach(link => {
            const href = link.getAttribute('href');
            
            if (currentPath === href || (href !== '/' && currentPath.startsWith(href))) {
                link.style.color = '#ff4444'; 
                link.classList.add('active'); 
            } else {
                link.style.color = '';
            }
        });
    });
</script>