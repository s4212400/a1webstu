<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Review - ConsoleHaven</title>
    <link rel="stylesheet" href="/shared.css">
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>

    <%- include('partials/header') %>

    <main id="main-content">
        <section class="page-header">
            <p class="thread-detail__breadcrumb"><a href="/reviews">← Back to Reviews</a></p>
            <h1 class="section-title">Edit Review</h1>
        </section>

        <section class="form-section">
            <div class="form-card">

                <form action="/reviews/edit/<%= review.id %>" method="POST" novalidate>

                    <div class="form-group">
                        <label class="form-label" for="review-title">Review Title</label>
                        <input type="text" id="review-title" name="title" class="form-input" value="<%= review.title %>">
                        <span class="error-message" id="title-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="review-description">Description</label>
                        <textarea id="review-description" name="description" class="form-textarea"><%= review.excerpt %></textarea>
                        <span class="error-message" id="description-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Your Rating</label>
                        <div class="rating-picker-wrap">
                            <fieldset class="rating-picker">
                                <input type="radio" id="star5" name="rating" value="5" <%= review.rating === 5 ? 'checked' : '' %>>
                                <label for="star5" title="5 stars">★</label>
                                <input type="radio" id="star4" name="rating" value="4" <%= review.rating === 4 ? 'checked' : '' %>>
                                <label for="star4" title="4 stars">★</label>
                                <input type="radio" id="star3" name="rating" value="3" <%= review.rating === 3 ? 'checked' : '' %>>
                                <label for="star3" title="3 stars">★</label>
                                <input type="radio" id="star2" name="rating" value="2" <%= review.rating === 2 ? 'checked' : '' %>>
                                <label for="star2" title="2 stars">★</label>
                                <input type="radio" id="star1" name="rating" value="1" <%= review.rating === 1 ? 'checked' : '' %>>
                                <label for="star1" title="1 star">★</label>
                            </fieldset>
                        </div>
                        <span class="error-message" id="rating-error"></span>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn--primary">Save Changes</button>
                        <a href="/reviews" class="btn btn--outline">Cancel</a>
                    </div>

                </form>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

</body>
</html>