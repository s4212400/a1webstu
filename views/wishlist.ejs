<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Wishlist | ConsoleHaven</title>

    <link rel="stylesheet" href="/shared.css">

</head>

<body>

<a href="#main-content" class="skip-link">
    Skip to main content
</a>

<%- include('partials/header') %>

<!-- HERO -->

<section class="wishlist-hero">

    <h1>
        My Wishlist
    </h1>

    <p>
        Save your favourite games and consoles for later.
    </p>

</section>

<!-- MAIN -->

<main
    id="main-content"
    class="wishlist-page"
>

<% if (!wishlist || wishlist.length === 0) { %>

    <!-- EMPTY WISHLIST -->

    <section
        class="wishlist-container"
        aria-label="Empty wishlist"
    >

        <article class="wishlist-card">

            <div class="wishlist-info">

                <h2>
                    Your wishlist is empty
                </h2>

                <p>
                    You haven't added any products to your wishlist yet.
                </p>

                <a
                    href="/shop"
                    class="btn btn--primary"
                >
                    Browse Shop
                </a>

            </div>

        </article>

    </section>

<% } else { %>

    <%
        const totalWishlist = wishlist.length;

        const purchasedItems = wishlist.filter(
            item => item.isPurchased
        ).length;

        const availableItems = wishlist.filter(
            item => item.stock !== "Out of Stock"
        ).length;
    %>

    <!-- WISHLIST ITEMS -->

    <section
        class="wishlist-container"
        aria-label="Wishlist items"
    >

        <% wishlist.forEach(item => { %>

            <article class="wishlist-card">

                <!-- Product Image -->

                <a
                    href="<%= item.productPage || '#' %>"
                >

                    <img
                        class="wishlist-image"
                        src="<%= item.image %>"
                        alt="Cover art of <%= item.name %>"
                    >

                </a>

                <!-- Product Information -->

                <div class="wishlist-info">

                    <h2>

                        <a
                            href="<%= item.productPage || '#' %>"
                        >
                            <%= item.name %>
                        </a>

                    </h2>

                    <p>

                        <%= item.platform || "Gaming" %>

                        <% if (item.genre) { %>

                            &bull;

                            <%= item.genre %>

                        <% } %>

                    </p>

                    <!-- Rating -->

                    <div class="rating">

                        <%= item.rating || "No rating" %>

                        <% if (item.ratingCount) { %>

                            <span class="rating-count">

                                (<%= item.ratingCount %>)

                            </span>

                        <% } %>

                    </div>

                    <!-- Price -->

                    <div class="price">

                        <% if (
                            item.oldPrice !== undefined &&
                            item.oldPrice !== null &&
                            Number(item.oldPrice) > Number(item.newPrice || item.price || 0)
                        ) { %>

                            <span class="old-price">

                                $<%= Number(item.oldPrice).toFixed(2) %>

                            </span>

                        <% } %>

                        <span class="new-price">

                            $<%= Number(
                                item.newPrice !== undefined
                                    ? item.newPrice
                                    : item.price || 0
                            ).toFixed(2) %>

                        </span>

                    </div>

                    <!-- Stock -->

                    <span
                        class="stock <%= item.stockClass || '' %>"
                    >

                        <%= item.stock || "Unknown" %>

                    </span>

                    <!-- Added Date -->

                    <% if (item.addedDate) { %>

                        <p>

                            Added:

                            <strong>
                                <%= item.addedDate %>
                            </strong>

                        </p>

                    <% } %>

                    <!-- Purchased Status -->

                    <% if (item.isPurchased) { %>

                        <p>

                            <strong>
                                Purchased
                            </strong>

                        </p>

                    <% } %>

                </div>

                <!-- WISHLIST ACTIONS -->

                <div class="wishlist-actions">

                    <!-- Move to Cart -->

                    <% if (
                        !item.isPurchased &&
                        item.stock !== "Out of Stock"
                    ) { %>

                        <a
                            href="/wishlist/move/<%= item.id %>"
                            class="btn btn--primary"
                        >
                            Move to Cart
                        </a>

                    <% } else if (item.stock === "Out of Stock") { %>

                        <button
                            type="button"
                            class="btn btn--outline"
                            disabled
                        >
                            Out of Stock
                        </button>

                    <% } else { %>

                        <button
                            type="button"
                            class="btn btn--outline"
                            disabled
                        >
                            Purchased
                        </button>

                    <% } %>


                    <!-- Purchased / Unpurchased -->

                    <% if (item.isPurchased) { %>

                        <a
                            href="/wishlist/unpurchase/<%= item.id %>"
                            class="btn btn--outline"
                        >
                            Mark Unpurchased
                        </a>

                    <% } else { %>

                        <a
                            href="/wishlist/purchase/<%= item.id %>"
                            class="btn btn--outline"
                        >
                            Mark Purchased
                        </a>

                    <% } %>


                    <!-- Remove -->

                    <a
                        href="/wishlist/remove/<%= item.id %>"
                        class="btn btn--outline btn--danger"
                        onclick="return confirm('Remove this product from your wishlist?')"
                    >
                        Remove
                    </a>

                </div>

            </article>

        <% }) %>

    </section>

    <!-- WISHLIST SUMMARY -->

    <aside
        class="wishlist-summary"
        aria-label="Wishlist summary"
    >

        <h2>
            Wishlist Summary
        </h2>

        <div class="summary-row">

            <span>
                Total Items
            </span>

            <span>
                <%= totalWishlist %>
            </span>

        </div>

        <div class="summary-row">

            <span>
                Available
            </span>

            <span>
                <%= availableItems %>
            </span>

        </div>

        <div class="summary-row">

            <span>
                Purchased
            </span>

            <span>
                <%= purchasedItems %>
            </span>

        </div>

        <a
            href="/shop"
            class="btn btn--primary summary-btn"
        >
            Continue Shopping
        </a>

    </aside>

<% } %>

</main>

 <%- include('partials/footer') %>

</body>
</html>