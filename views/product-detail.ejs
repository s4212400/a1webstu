<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> | ConsoleHaven</title>
    <link rel="stylesheet" href="/shared.css">
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>

    <%- include('partials/header') %>

    <section class="product-reviews">
 
            <div class="reviews-header">
                <h2>Customer Reviews</h2>
                <% if (user) { %>
                    <a href="/reviews/create?productId=<%= product.productId %>" class="btn btn--primary btn--small">
                        Write a Review
                    </a>
                <% } else { %>
                    <a href="/login" class="btn btn--outline btn--small">Log in to review</a>
                <% } %>
            </div>
 
            <% if (reviews && reviews.length > 0) { %>
                <div class="reviews-list">
                    <% reviews.forEach(function(review) { %>
                        <div class="review-card">
                            <div class="review-card__header">
                                <span class="review-card__stars"><%= "⭐".repeat(review.rating) %></span>
                                <span class="review-card__author">
                                    by <%= review.author ? review.author.fullname : 'Unknown' %>
                                </span>
                                <span class="review-card__date">
                                    <%= new Date(review.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                </span>
                            </div>
                            <h3 class="review-card__title">
                                <a href="/reviews/<%= review._id %>"><%= review.title %></a>
                            </h3>
                            <p class="review-card__text"><%= review.description %></p>
 
                            <% if (user && user._id && review.author && review.author._id && (review.author._id.toString() === user._id.toString() || user.username === "admin123")) { %>
                                <div class="review-card__actions">
                                    <a href="/reviews/edit/<%= review._id %>" class="btn btn--outline btn--small">Edit</a>
                                    <form action="/reviews/delete/<%= review._id %>" method="POST" style="display:inline;">
                                        <button type="submit" class="btn btn--danger btn--small" onclick="return confirm('Delete this review?')">Delete</button>
                                    </form>
                                </div>
                            <% } %>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <p class="no-reviews">No reviews yet — be the first to review this product!</p>
            <% } %>
 
        </section>
        
    <main id="main-content" class="product-page">

        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/shop">← Back to Shop</a>
        </nav>

        <section class="product-overview">

            <div class="product-gallery">
                <img class="product-gallery__main" src="<%= product.image %>" alt="<%= product.name %>">
            </div>

            <div class="product-buy">

                <h1 class="product-title"><%= product.name %></h1>

                <p class="product-sub">
                    <% if (product.platform === 'ps5') { %>PlayStation 5
                    <% } else if (product.platform === 'xbox') { %>Xbox Series X
                    <% } else if (product.platform === 'switch') { %>Nintendo Switch
                    <% } %>
                    &bull; <%= product.category.charAt(0).toUpperCase() + product.category.slice(1) %>
                </p>

                <div class="rating">
                    <%= "⭐".repeat(product.rating) %>
                    <span class="rating-count">
                        <%= product.rating %>.0 / 5 —
                        <%= product.ratingCount.toLocaleString() %> reviews
                    </span>
                </div>

                <div class="price product-price">
                    <% if (product.oldPrice) { %>
                        <span class="old-price">
                            $<%= product.oldPrice.toFixed(2) %>
                        </span>
                    <% } %>

                    <span class="new-price">
                        $<%= product.price.toFixed(2) %>
                    </span>

                    <% if (product.discount) { %>
                        <span class="save-tag">
                            Save <%= product.discount %>%
                        </span>
                    <% } %>
                </div>

                <% if (product.stock === 0) { %>

                    <span class="stock out-stock">
                        Out of Stock
                    </span>

                <% } else if (product.stock <= 6) { %>

                    <span class="stock low-stock">
                        Low Stock — <%= product.stock %> units left
                    </span>

                <% } else { %>

                    <span class="stock in-stock">
                        In Stock — <%= product.stock %> units available
                    </span>

                <% } %>


                <!-- Add to Cart -->
                <form class="product-form" action="/cart/add" method="POST">

                    <!-- Use product.productId from MongoDB -->
                    <input
                        type="hidden"
                        name="productId"
                        value="<%= product.productId %>"
                    >

                    <div class="form-group">
                        <label for="quantity">Quantity</label>

                        <input
                            type="number"
                            id="quantity"
                            name="quantity"
                            value="1"
                            min="1"
                            max="<%= product.stock > 0 ? product.stock : 1 %>"
                            <%= product.stock === 0 ? 'disabled' : '' %>
                        >
                    </div>

                    <% if (user) { %>

                        <button
                            type="submit"
                            class="btn btn--primary btn--large"
                            <%= product.stock === 0 ? 'disabled' : '' %>
                        >
                            <%= product.stock === 0
                                ? 'Out of Stock'
                                : 'Add to Cart' %>
                        </button>

                    <% } else { %>

                        <a
                            href="/login"
                            class="btn btn--primary btn--large"
                        >
                            Log in to add to cart
                        </a>

                    <% } %>

                </form>

            </div>

        </section>

    </main>

    <%- include('partials/footer') %>

</body>
</html>